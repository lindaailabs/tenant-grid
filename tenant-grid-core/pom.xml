<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.lindaailabs</groupId>
    <artifactId>tenant-grid</artifactId>
    <version>0.5.0</version>
  </parent>

  <artifactId>tenant-grid-core</artifactId>
  <name>Tenant Grid :: Core</name>
  <description>
    Routing kernel: resolves a tenantId to a shard placement (physical or logical).
    Zero Spring dependency — usable standalone and fast to unit test.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- 线程池场景下的租户上下文传播（TenantContext） -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>transmittable-thread-local</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 嵌入式数据库：JdbcMigrationStore 需要真跑 SQL，内存库放不出去 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
